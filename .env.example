# Copiar a .env y ajustar. docker compose lo lee automáticamente.
POSTGRES_DB=catalogo
POSTGRES_USER=catalogo
POSTGRES_PASSWORD=catalogo
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Poner en 1 solo al desplegar detras de HTTPS (activa redireccion y HSTS).
DJANGO_SSL_REDIRECT=0
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin1234
# Horas de vida del token de la API REST.
API_TOKEN_TTL_HORAS=8
